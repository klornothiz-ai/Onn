# EditorConfig - https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hpp}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{c}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{py}]
indent_style = space
indent_size = 4

[*.{js,ts,jsx,tsx}]
indent_style = space
indent_size = 2

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

[*.{md}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.cmake]
indent_style = space
indent_size = 4

[*.{sh,bash}]
indent_style = space
indent_size = 4

[*.{cmake}]
indent_style = space
indent_size = 4

[*.{txt}]
indent_style = space
indent_size = 4

[*.{xml}]
indent_style = space
indent_size = 2

[*.{html}]
indent_style = space
indent_size = 2

